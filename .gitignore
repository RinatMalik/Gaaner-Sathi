# Trimmed to this project's stack: Node/TypeScript/Vite and the reference test
# harness. Lockfiles (package-lock.json) are intentionally NOT ignored: commit them.

# ── OS junk ─────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*~

# ── Editor / IDE ────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
# .vscode/ is often worth committing (shared extensions.json / settings.json).
# Ignore only the noisy per-user bits instead of the whole folder:
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# ── Secrets / environment ───────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Node / TypeScript / Vite ────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
.cache/
coverage/
*.tsbuildinfo
.vitest/

# ── Reference test harness output (regenerated by run-all.sh) ───────────────
reference/tests/.extracted/

# ── Misc ────────────────────────────────────────────────────────────────────
*.tmp
.tmp/

# ── Pitch data downloaded from the app, for Claude to read (private: never committed) ──
feedback/
