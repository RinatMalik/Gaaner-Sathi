# .env.example — key NAMES only, no values. Safe to commit.
#
# Copy this to `.env` (which git ignores) and paste your real key after each `=`.
# bootstrap.bat does that copy for you. NEVER put a real value in THIS file.
# Format is NAME=value with no spaces around `=`.
#
# The names below are a CONVENIENCE MENU of common providers, not a statement
# that this project uses them. Delete the ones you don't use so nobody (human or
# agent) infers an unused dependency; add project-specific ones as needed.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACE_TOKEN=
